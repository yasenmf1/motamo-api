{
  "version": 2,
  "functions": {
    "api/menu.js": {
      "maxDuration": 10
    },
    "api/order.js": {
      "maxDuration": 10
    },
    "api/cex-plan.js": {
      "maxDuration": 60
    },
    "api/pay-return.js": {
      "maxDuration": 30
    },
    "api/wolt-drive.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/transfer?cron=stock",
      "schedule": "0 4 * * 1-6"
    },
    {
      "path": "/api/transfer?cron=clean",
      "schedule": "5 21 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/:slug([a-z0-9-]+)",
      "has": [
        {
          "type": "host",
          "value": "zayavka.motamo.bg"
        }
      ],
      "destination": "/api/cex-plan?view=zayavka&s=:slug"
    }
  ]
}
